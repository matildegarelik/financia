{
    "name": "Account",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "Nombre de la cuenta"
        },
        "type": {
            "type": "string",
            "enum": [
                "checking",
                "savings",
                "credit_card",
                "cash",
                "investment",
                "other"
            ],
            "description": "Tipo de cuenta"
        },
        "currency": {
            "type": "string",
            "enum": [
                "USD",
                "EUR",
                "COP",
                "ARS",
                "CLP",
                "PEN"
            ],
            "default": "ARS",
            "description": "Moneda de la cuenta"
        },
        "balance": {
            "type": "number",
            "default": 0,
            "description": "Saldo actual"
        },
        "color": {
            "type": "string",
            "description": "Color para identificar la cuenta"
        },
        "icon": {
            "type": "string",
            "description": "Icono de la cuenta"
        },
        "is_active": {
            "type": "boolean",
            "default": true
        },
        "statement_close_day": {
            "type": "number",
            "description": "Dia de cierre de resumen para tarjetas de credito"
        },
        "statement_due_day": {
            "type": "number",
            "description": "Dia de vencimiento de resumen para tarjetas de credito"
        },
        "default_payment_account_id": {
            "type": "string",
            "description": "Cuenta desde la que se paga la tarjeta por defecto"
        },
        "credit_limit": {
            "type": "number",
            "description": "Limite opcional de la tarjeta"
        }
    },
    "required": [
        "name",
        "type"
    ]
}
