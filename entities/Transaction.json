{
    "name": "Transaction",
    "type": "object",
    "properties": {
        "date": {
            "type": "string",
            "format": "date"
        },
        "type": {
            "type": "string",
            "enum": [
                "income",
                "expense",
                "transfer"
            ],
            "default": "expense"
        },
        "status": {
            "type": "string",
            "enum": [
                "confirmed",
                "installment",
                "projected"
            ],
            "default": "confirmed"
        },
        "amount": {
            "type": "number"
        },
        "amount_gross": {
            "type": "number"
        },
        "currency": {
            "type": "string",
            "default": "ARS"
        },
        "to_amount": {
            "type": "number"
        },
        "to_currency": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "account_id": {
            "type": "string"
        },
        "account_name": {
            "type": "string"
        },
        "to_account_id": {
            "type": "string"
        },
        "to_account_name": {
            "type": "string"
        },
        "category_id": {
            "type": "string"
        },
        "category_name": {
            "type": "string"
        },
        "notes": {
            "type": "string"
        },
        "is_recurring": {
            "type": "boolean",
            "default": false
        },
        "recurring_frequency": {
            "type": "string"
        },
        "installment_total": {
            "type": "number"
        },
        "installment_current": {
            "type": "number"
        },
        "project_name": {
            "type": "string"
        },
        "client_name": {
            "type": "string"
        },
        "probability": {
            "type": "number"
        },
        "due_date": {
            "type": "string",
            "format": "date"
        },
        "is_investment_transfer": {
            "type": "boolean",
            "default": false
        },
        "credit_card_statement_id": {
            "type": "string"
        },
        "purchase_date": {
            "type": "string",
            "format": "date"
        },
        "installment_group_id": {
            "type": "string"
        },
        "is_credit_card_payment": {
            "type": "boolean",
            "default": false
        }
    },
    "required": [
        "type",
        "amount"
    ]
}
